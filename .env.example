# Copiar para .env e preencher. NUNCA commitar o .env.
# Em producao estes valores sao definidos como variaveis de ambiente no Coolify.

APP_PROFILE=dev
SERVER_PORT=8090

# --- PostgreSQL -----------------------------------------------------------
# Em local: o contentor ds-db do docker-compose expoe a porta 5442 (a 5432
# fica livre para a Everlee Grace).
# O utilizador precisa de permissao CREATEDB: o sistema cria uma base de dados
# por cada empresa/tenant registada.
DB_HOST=localhost
DB_PORT=5442
DB_MASTER_NAME=ds_master
DB_USERNAME=postgres
DB_PASSWORD=

# --- Primeiro super administrador -----------------------------------------
# Definir APENAS no primeiro arranque. Depois de a conta existir o runner e
# ignorado; remove estas variaveis do ambiente a seguir.
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# --- JWT ------------------------------------------------------------------
# Gerar com: openssl rand -hex 32  (diferente do da Everlee Grace)
JWT_SECRET=
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# --- CORS -----------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:8095,https://app.detailingstudio.co.mz

# --- Email ----------------------------------------------------------------
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_FROM=nao-responder@detailingstudio.co.mz
FRONTEND_BASE_URL=http://localhost:8095

# --- Uploads --------------------------------------------------------------
UPLOAD_MAX_FILE_SIZE_MB=10
UPLOAD_MAX_REQUEST_SIZE_MB=20
